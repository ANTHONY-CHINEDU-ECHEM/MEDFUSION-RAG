+"""MedFusion RAG command line entry point.
+
+Usage:
+    python run.py data        generate the cohort, data dictionary, knowledge base and knowledge graph
+    python run.py prepare     fit the tokenizer, render and cache images, precompute retrieval
+    python run.py train       train MedFusion VLM and save the best checkpoint
+    python run.py evaluate    run the full test evaluation, baselines, ablations and figures
+    python run.py explain     produce XAI panels and evidence chains
+    python run.py demo        run the clinical assistant demo
+    python run.py audit       verify that no hyphen or dash character exists anywhere
+    python run.py all         data, prepare, train, evaluate, explain and demo in sequence
+
+Any configuration value can be overridden with dotted key=value pairs, for
+example: python run.py train training.epochs=8 model.d_model=192
+"""
+from __future__ import annotations
+
+import sys
+
+from medfusion.utils import get_logger, load_config, set_seed
+
+LOGGER = get_logger("run")
+
+
+def cmd_data(cfg: dict):
+    from medfusion.data.dataset import build_dataset
+
+    frame = build_dataset(cfg, force=False)
+    LOGGER.info("Cohort ready with shape %s", frame.shape)
+
+
+def cmd_prepare(cfg: dict):
+    from medfusion.training.trainer import prepare_context
+
+    prepare_context(cfg)
+    LOGGER.info("Tokenizer, image cache and retrieval context ready")
+
+
+def cmd_train(cfg: dict):
+    from medfusion.training.trainer import train
+
+    train(cfg)
+
+
+def cmd_evaluate(cfg: dict):
+    from medfusion.evaluation.evaluate import evaluate
+
+    evaluate(cfg)
+
+
+def cmd_explain(cfg: dict):
+    from medfusion.xai.explain import explain_cases
+
+    explain_cases(cfg)
+
+
+def cmd_demo(cfg: dict):
+    from medfusion.inference.assistant import demo
+
+    demo(cfg)
+
+
+def cmd_audit(cfg: dict):
+    from tools.hyphen_audit import main as audit_main
+
+    saved = sys.argv
+    sys.argv = saved[:1]
+    try:
+        return audit_main()
+    finally:
+        sys.argv = saved
+
+
+COMMANDS = {
+    "data": cmd_data, "prepare": cmd_prepare, "train": cmd_train, "evaluate": cmd_evaluate,
+    "explain": cmd_explain, "demo": cmd_demo, "audit": cmd_audit,
+}
+PIPELINE = ("data", "prepare", "train", "evaluate", "explain", "demo")
+
+
+def main(argv: list[str] | None = None):
+    args = list(sys.argv[1:] if argv is None else argv)
+    if not args or args[0] not in (*COMMANDS, "all"):
+        print(__doc__)
+        return 2
+    command, overrides = args[0], [a for a in args[1:] if "=" in a]
+    cfg = load_config(overrides=overrides)
+    set_seed(cfg["seed"])
+    steps = PIPELINE if command == "all" else (command,)
+    for step in steps:
+        LOGGER.info("Running step: %s", step)
+        status = COMMANDS[step](cfg)
+        if status:
+            return status
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
